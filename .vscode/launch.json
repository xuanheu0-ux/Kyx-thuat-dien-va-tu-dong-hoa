{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug test mô phỏng GSP (Node)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tools/test_gsp_sim.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug công cụ Python (serve 8000)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": [
        "serve",
        "8000"
      ],
      "cwd": "${workspaceFolder}"
    }
  ]
}
